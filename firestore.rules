rules_version = '2';

// Server-side authorization: every document is scoped to a workspace, and the
// signed-in user must be a member of that workspace. user profiles are private
// to their owner; the users collection is readable so member lookups work.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function workspaceMember(wid) {
      return isSignedIn() && wid is string && exists(/databases/$(database)/documents/workspaces/$(wid))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(wid)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /workspaces/{workspaceId} {
      allow read, update: if workspaceMember(workspaceId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /workspace_members/{memberId} {
      allow read: if isSignedIn() && workspaceMember(resource.data.workspaceId);
      allow create: if isSignedIn() && workspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isSignedIn() && workspaceMember(resource.data.workspaceId);
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && workspaceMember(resource.data.workspaceId);
      allow create: if isSignedIn() && workspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isSignedIn() && workspaceMember(resource.data.workspaceId);
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && workspaceMember(resource.data.workspaceId);
      allow create: if isSignedIn() && workspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isSignedIn() && workspaceMember(resource.data.workspaceId);
    }

    match /activity/{activityId} {
      allow read: if isSignedIn() && workspaceMember(resource.data.workspaceId);
      allow create: if isSignedIn() && workspaceMember(request.resource.data.workspaceId)
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
